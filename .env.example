# =====================================================================
# AutoMitra Configuration Environment
# Stack: MySQL, Python Flask, HTML/CSS (Currency: INR ₹)
# =====================================================================

# Flask App Secret
SECRET_KEY=automitra-secret-key-prod-2026

# MySQL Database Settings
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=automitra

# Direct Database URL format (MySQL with PyMySQL driver):
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/automitra?charset=utf8mb4

# Toggle to true if running without local MySQL server (uses embedded SQLite):
USE_SQLITE=false

# Server Port
PORT=5000
