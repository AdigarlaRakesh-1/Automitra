# =====================================================================
# AutoMitra Configuration Environment
# Stack: MySQL, Python Flask, HTML/CSS (Currency: INR ₹)
# =====================================================================

# Flask App Secret (Required in production)
SECRET_KEY=your-secure-random-secret-key-here

# MySQL Database Settings
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=automitra

# Direct Database URL format (MySQL with PyMySQL driver):
# DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@localhost:3306/automitra?charset=utf8mb4

# Explicitly toggle to true if running without local MySQL server (uses embedded SQLite for dev/test):
USE_SQLITE=true

# Server Settings
PORT=5000
FLASK_DEBUG=false
FLASK_ENV=development
